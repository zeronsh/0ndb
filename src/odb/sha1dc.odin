package odb

import "core:encoding/endian"
import "core:math/bits"

Sha1dc :: struct {
	total:              u64,
	ihv:                [5]u32,
	buffer:             [64]u8,
	found_collision:    bool,
	safe_hash:          bool,
	detect_coll:        bool,
	ubc_check:          bool,
	reduced_round_coll: bool,
	ihv1:               [5]u32,
	ihv2:               [5]u32,
	m1:                 [80]u32,
	m2:                 [80]u32,
	state58:            [5]u32,
	state65:            [5]u32,
}

sha1dc_init :: proc(ctx: ^Sha1dc) {
	if ctx == nil {
		return
	}
	ctx^ = {}
	ctx.ihv = {0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0}
	ctx.safe_hash = false
	ctx.detect_coll = true
	ctx.ubc_check = true
	ctx.reduced_round_coll = false
}

sha1dc_update :: proc(ctx: ^Sha1dc, data: []u8) {
	if ctx == nil || len(data) == 0 {
		return
	}
	data := data
	left := int(ctx.total & 63)
	fill := 64 - left
	if left != 0 && len(data) >= fill {
		ctx.total += u64(fill)
		copy(ctx.buffer[left:], data[:fill])
		dc_process(ctx, &ctx.buffer)
		data = data[fill:]
		left = 0
	}
	for len(data) >= 64 {
		ctx.total += 64
		dc_process(ctx, (^[64]u8)(raw_data(data)))
		data = data[64:]
	}
	if len(data) > 0 {
		ctx.total += u64(len(data))
		copy(ctx.buffer[left:], data)
	}
}

sha1dc_final :: proc(ctx: ^Sha1dc) -> (digest: [20]u8, collision: bool) {
	if ctx == nil {
		return
	}
	last := ctx.total & 63
	padn := 56 - last if last < 56 else 120 - last
	sha1dc_update(ctx, dc_padding[:padn])
	endian.unchecked_put_u64be(ctx.buffer[56:], (ctx.total - padn) << 3)
	dc_process(ctx, &ctx.buffer)
	for v, i in ctx.ihv {
		endian.unchecked_put_u32be(digest[4 * i:], v)
	}
	return digest, ctx.found_collision
}

@(private)
dc_Dv_Info :: struct {
	dv_type: int,
	dv_k:    int,
	dv_b:    int,
	testt:   int,
	maski:   int,
	maskb:   int,
	dm:      [80]u32,
}

@(private, rodata)
dc_padding := [64]u8{0 = 0x80}

@(private)
dc_f1 :: #force_inline proc "contextless" (b, c, d: u32) -> u32 {
	return d ~ (b & (c ~ d))
}

@(private)
dc_f2 :: #force_inline proc "contextless" (b, c, d: u32) -> u32 {
	return b ~ c ~ d
}

@(private)
dc_f3 :: #force_inline proc "contextless" (b, c, d: u32) -> u32 {
	return (b & c) + (d & (b ~ c))
}

@(private)
dc_round :: #force_inline proc "contextless" (i: int, b, c, d: u32) -> u32 {
	switch {
	case i < 20:
		return dc_f1(b, c, d) + 0x5A827999
	case i < 40:
		return dc_f2(b, c, d) + 0x6ED9EBA1
	case i < 60:
		return dc_f3(b, c, d) + 0x8F1BBCDC
	}
	return dc_f2(b, c, d) + 0xCA62C1D6
}

@(private)
dc_expand :: #force_inline proc "contextless" (w: ^[80]u32, i: int) -> u32 {
	return bits.rotate_left32(w[i - 3] ~ w[i - 8] ~ w[i - 14] ~ w[i - 16], 1)
}

@(private)
dc_compression_states :: #force_no_inline proc "contextless" (ihv: ^[5]u32, block: ^[64]u8, w: ^[80]u32, state58, state65: ^[5]u32) {
	a, b, c, d, e := ihv[0], ihv[1], ihv[2], ihv[3], ihv[4]
	#unroll for i in 0 ..< 16 {
		x := endian.unchecked_get_u32be(block[4 * i:])
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f1(b, c, d) + 0x5A827999 + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	#unroll for i in 16 ..< 20 {
		x := dc_expand(w, i)
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f1(b, c, d) + 0x5A827999 + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	#unroll for i in 20 ..< 40 {
		x := dc_expand(w, i)
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f2(b, c, d) + 0x6ED9EBA1 + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	#unroll for i in 40 ..< 58 {
		x := dc_expand(w, i)
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f3(b, c, d) + 0x8F1BBCDC + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	state58^ = {a, b, c, d, e}
	#unroll for i in 58 ..< 60 {
		x := dc_expand(w, i)
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f3(b, c, d) + 0x8F1BBCDC + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	#unroll for i in 60 ..< 65 {
		x := dc_expand(w, i)
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f2(b, c, d) + 0xCA62C1D6 + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	state65^ = {a, b, c, d, e}
	#unroll for i in 65 ..< 80 {
		x := dc_expand(w, i)
		w[i] = x
		t := bits.rotate_left32(a, 5) + dc_f2(b, c, d) + 0xCA62C1D6 + e + x
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	ihv[0] += a
	ihv[1] += b
	ihv[2] += c
	ihv[3] += d
	ihv[4] += e
}

@(private)
dc_compression_w :: proc "contextless" (ihv: ^[5]u32, w: ^[80]u32) {
	a, b, c, d, e := ihv[0], ihv[1], ihv[2], ihv[3], ihv[4]
	for i in 0 ..< 80 {
		t := bits.rotate_left32(a, 5) + dc_round(i, b, c, d) + e + w[i]
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	ihv[0] += a
	ihv[1] += b
	ihv[2] += c
	ihv[3] += d
	ihv[4] += e
}

@(private)
dc_recompression_step :: proc "contextless" (step: int, ihvin, ihvout: ^[5]u32, me2: ^[80]u32, state: [5]u32) {
	a, b, c, d, e := state[0], state[1], state[2], state[3], state[4]
	for i := step - 1; i >= 0; i -= 1 {
		t := a
		a, b, c, d = b, bits.rotate_left32(c, 2), d, e
		e = t - (bits.rotate_left32(a, 5) + dc_round(i, b, c, d) + me2[i])
	}
	ihvin^ = {a, b, c, d, e}
	a, b, c, d, e = state[0], state[1], state[2], state[3], state[4]
	for i in step ..< 80 {
		t := bits.rotate_left32(a, 5) + dc_round(i, b, c, d) + e + me2[i]
		a, b, c, d, e = t, a, bits.rotate_left32(b, 30), c, d
	}
	ihvout^ = {ihvin[0] + a, ihvin[1] + b, ihvin[2] + c, ihvin[3] + d, ihvin[4] + e}
}

@(private)
dc_process :: proc "contextless" (ctx: ^Sha1dc, block: ^[64]u8) {
	ctx.ihv1 = ctx.ihv
	dc_compression_states(&ctx.ihv, block, &ctx.m1, &ctx.state58, &ctx.state65)
	if !ctx.detect_coll {
		return
	}
	mask := ~u32(0)
	if ctx.ubc_check {
		mask = dc_ubc_check(&ctx.m1)
	}
	if mask == 0 {
		return
	}
	for &dv in dc_sha1_dvs {
		if mask & (u32(1) << uint(dv.maskb)) == 0 {
			continue
		}
		for j in 0 ..< 80 {
			ctx.m2[j] = ctx.m1[j] ~ dv.dm[j]
		}
		state: [5]u32
		switch dv.testt {
		case 58:
			state = ctx.state58
		case 65:
			state = ctx.state65
		case:
			continue
		}
		ihvtmp: [5]u32
		dc_recompression_step(dv.testt, &ctx.ihv2, &ihvtmp, &ctx.m2, state)
		if ihvtmp == ctx.ihv || (ctx.reduced_round_coll && ctx.ihv1 == ctx.ihv2) {
			ctx.found_collision = true
			if ctx.safe_hash {
				dc_compression_w(&ctx.ihv, &ctx.m1)
				dc_compression_w(&ctx.ihv, &ctx.m1)
			}
			break
		}
	}
}

